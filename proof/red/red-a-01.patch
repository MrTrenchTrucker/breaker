-
-        // "B\u0435\u0430r\u0435r" with Cyrillic e (U+0435) and a (U+0430) -- looks like "Bearer"
-        // but equals("bearer", ignoreCase = true) is false.
-        val lookalike = "B\u0435\u0430r\u0435r ${adminSession.secret.reveal()}"
-
-        testApplication {
