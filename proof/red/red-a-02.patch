-    fun scopesFor(role: UserRole): Set<TokenScope> = when (role) {
-        UserRole.USER -> setOf(TokenScope.TRANSCRIBE)
-        UserRole.ADMIN -> setOf(TokenScope.TRANSCRIBE, TokenScope.ADMIN)
