-    const val ITERATIONS = 3
-    const val PARALLELISM = 1
-    const val KDF_VERSION = 1
-    const val OUTPUT_LENGTH = 32
-    const val SALT_BYTES = 16
-    const val MIN_PASSWORD_CHARS = 12
-
