-                                    event = event,
-                                    record = RecordState.IN_FLIGHT,
-                                    session = session,
-                                    ageMillis = age,
-                                    installed = installed,
-                                    lastSeen = seen,
-                                    status = status,
-                                    lastOutcome = outcome,
-                                ),
-                            )
-                        }
-                    }
-                }
-            }
-        }
-    }
