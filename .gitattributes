# Keep line endings as committed (LF) on every platform. The agent-skills
# contract test hashes SKILL.md bytes, and scripts must run in WSL and
# containers, so a Windows checkout must not convert them to CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary

# Vendored libraries under web-libs carry upstream trailing whitespace;
# do not touch them. git apply --check --whitespace=error must pass on them.
shared/modules/web-libs/** -whitespace
