# Breaker stack environment: NAMES and placeholders only, never a value that
# is a secret. Copy this file to .env (the repository ignores .env) and fill in
# every name before `docker compose up`.
#
# Example addresses in private space (10.20.30.x); placeholders, not real hosts.

# Release tag used for every image; rollback is the previous tag. Never latest.
BREAKER_IMAGE_TAG=

# Host address the published ports bind to: the VPN or private address of the
# host, never a wildcard and never a public address.
BREAKER_BIND_ADDR=

# One compose network with a fixed subnet, and one fixed address per service.
BREAKER_NETWORK_SUBNET=10.20.30.0/24
BREAKER_SYNC_API_ADDRESS=10.20.30.11
BREAKER_WHISPER_ADDRESS=10.20.30.12
BREAKER_WEB_FE_ADDRESS=10.20.30.13
BREAKER_TRAINING_ADDRESS=10.20.30.14

# Listening ports, above 1024: the containers run unprivileged.
BREAKER_SYNC_API_PORT=
BREAKER_SYNC_API_INTERNAL_PORT=
BREAKER_WHISPER_PORT=
BREAKER_WEB_FE_PORT=

# The transcription backend whisper-server forwards to.
BREAKER_WHISPER_FORWARDER_URL=

# Secret names. The values live outside this repository, in the operator's .env
# file and in the host file named below; nothing here is a value.
BREAKER_WHISPER_SYNC_API_SERVICE_KEY=
# Service key file rules, from ServiceKeyFile.kt:17, :62, :77 (KEY_LENGTH, checkOwnerOnly, parseKey):
# the file named below must be exactly 43 characters of the URL-safe alphabet A-Z a-z 0-9 _ - with at most one trailing newline
# it must be owner-only: mode 0600, no group or other permission bits
# it must exist before `up`: a missing source path makes the container runtime create a directory there and sync-api refuses to start
# the container reads it as uid 10001, so on the host the file must be owned by uid 10001
BREAKER_SYNC_API_SERVICE_KEY_HOST=
