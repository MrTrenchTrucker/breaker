<?xml version="1.0" encoding="utf-8"?>
<!--
  Card: android/app/AGENTS.md   Registry: modules.toml [module.android_app]

  The app identity (namespace, applicationId, minSdk, targetSdk) is set in
  build.gradle.kts. This file names the application class and the single
  launcher activity, and adds nothing else: no services, receivers, providers,
  permissions, icon, label or theme are declared here.

  The application class (BreakerApp) builds the composition root, the only
  place the modules are composed. The launcher activity (SettingsLauncherActivity)
  hosts the settings screen the ui module builds; the app owns the window, the
  ui module owns no window. The launcher activity is the settings screen;
  launching it has not been verified on a device.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".BreakerApp">
        <activity
            android:name=".SettingsLauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
