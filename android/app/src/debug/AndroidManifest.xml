<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug build only: the Home microphone probe. This file is the debug source
  set's manifest, merged into the debug build and into no other build, so the
  release build has no probe receiver and no probe provider. The probe is
  temporary and is removed before release; this file goes with it.

  The receiver is exported for the debug broadcast that drives the probe. The
  provider holds no data: it starts the probe with the process. It is not
  exported. The probe log page is an activity with no intent filter, so it adds
  no launcher icon; the one launcher activity gets the static shortcut that opens
  it by a merge of one meta-data element.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name=".probe.MicProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.breaker.debug.MIC" />
            </intent-filter>
        </receiver>
        <provider
            android:name=".probe.MicProbeBootstrap"
            android:authorities="${applicationId}.micprobe"
            android:exported="false" />
        <activity
            android:name=".probe.ProbeLogActivity"
            android:exported="false" />
        <activity
            android:name=".SettingsLauncherActivity"
            android:exported="true"
            tools:node="merge">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/probe_shortcuts" />
        </activity>
    </application>
</manifest>
