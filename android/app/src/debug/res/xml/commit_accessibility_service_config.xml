<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug build only: the keyboard signal probe's accessibility service config.
  It overrides the library's file of the same name (android/modules/commit/
  accessibility/src/main/res/xml/commit_accessibility_service_config.xml) in the
  debug build; the release build keeps the library's file unchanged.

  Why: the probe finds the keyboard window in the window list, which needs the
  interactive-windows flag, and the window events wake the probe when a window or
  a field changes. The four baseline attributes are copied from the library file;
  the event types and the flag are the only additions.

  This file is removed with the probe selector before release.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeWindowsChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/commit_accessibility_service_description" />
